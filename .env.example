# 复制为 .env；npm start 自动读取。请填写自己的随机密钥。
HOST=127.0.0.1
PORT=8787
CAPTCHA_SECRET=
# 精确来源，包含协议和端口；多个 origin 以逗号分隔，无末尾斜杠。
CAPTCHA_ALLOWED_ORIGINS=http://127.0.0.1:8788,http://localhost:8788
# 仅支持紧邻服务的单层反向代理；不配置时忽略 X-Forwarded-For。
CAPTCHA_TRUSTED_PROXIES=
CAPTCHA_BASE_PATH=/captcha/v1
CAPTCHA_ASSET_PATH=/captcha/assets
CAPTCHA_ENABLED=true
CAPTCHA_MODE=strict
CAPTCHA_POW_BITS=20
CAPTCHA_TOLERANCE=10
CAPTCHA_MIN_SOLVE_MS=1000
CAPTCHA_MIN_TOKEN_AGE_MS=300
CAPTCHA_TOKEN_TTL_MS=300000
CAPTCHA_CHALLENGE_TTL_MS=300000
CAPTCHA_POW_TTL_MS=120000
CAPTCHA_MAX_CHALLENGES_PER_IP=3
CAPTCHA_CHALLENGE_TRIES=3
CAPTCHA_RATE_LIMIT=60
CAPTCHA_RATE_WINDOW_MS=600000
CAPTCHA_IMAGES_DIR=
