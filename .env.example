# 复制为 .env；npm start 自动读取。请填写自己的随机密钥。
HOST=127.0.0.1
PORT=8787
CAPTCHA_SECRET=
# 填写实际业务页面的精确来源，包含协议和端口；多个 origin 以逗号分隔，无末尾斜杠。
CAPTCHA_ALLOWED_ORIGINS=
# 仅支持紧邻服务的单层反向代理；不配置时忽略 X-Forwarded-For。
CAPTCHA_TRUSTED_PROXIES=
# 默认 x-forwarded-for；Cloudflare Tunnel 改为 cf-connecting-ip。
# cloudflared 同机部署时，可信代理填写 127.0.0.1,::1，HOST 保持 127.0.0.1。
CAPTCHA_CLIENT_IP_HEADER=x-forwarded-for
# 默认 Blackbox v1，无需 API Key；设置 off 可关闭信誉查询。
CAPTCHA_IP_REPUTATION_PROVIDER=blackbox
# CAPTCHA_BLACKBOX_TIMEOUT_MS=2500
# CAPTCHA_BLACKBOX_CACHE_TTL_MS=3600000
# 可选 IPQS：切换 CAPTCHA_IP_REPUTATION_PROVIDER=ipqs 并填写 Key。
# Key 只由后端持有；选择 blackbox 时不会调用 IPQS。
IPQS_API_KEY=
# 下列配置按需取消注释；启用前必须填写 IPQS_API_KEY。
# CAPTCHA_IPQS_TIMEOUT_MS=2500
# CAPTCHA_IPQS_CACHE_TTL_MS=3600000
# CAPTCHA_IPQS_STRICTNESS=0
# 默认仅增加 PoW，设置此项后拦截大于等于阈值的风险分。
# CAPTCHA_IPQS_BLOCK_SCORE=90
CAPTCHA_BASE_PATH=/captcha/v1
CAPTCHA_ASSET_PATH=/captcha/assets
CAPTCHA_ENABLED=true
CAPTCHA_MODE=strict
CAPTCHA_POW_BITS=20
CAPTCHA_TOLERANCE=10
CAPTCHA_MIN_SOLVE_MS=1000
CAPTCHA_MIN_TOKEN_AGE_MS=300
CAPTCHA_TOKEN_TTL_MS=300000
CAPTCHA_CHALLENGE_TTL_MS=300000
CAPTCHA_POW_TTL_MS=120000
CAPTCHA_MAX_CHALLENGES_PER_IP=3
CAPTCHA_CHALLENGE_TRIES=3
CAPTCHA_RATE_LIMIT=60
CAPTCHA_RATE_WINDOW_MS=600000
CAPTCHA_IMAGES_DIR=
