# 复制为 .dev.vars，用自己的随机密钥替换占位符；不会部署到云端。
CAPTCHA_SECRET="replace-with-your-own-random-secret-at-least-32-characters"
# 默认 Blackbox v1，无需 API Key。
CAPTCHA_IP_REPUTATION_PROVIDER="blackbox"
# CAPTCHA_BLACKBOX_TIMEOUT_MS="2500"
# CAPTCHA_BLACKBOX_CACHE_TTL_MS="3600000"
# 可选 IPQS：provider 改为 ipqs，云端使用 npx wrangler secret put IPQS_API_KEY。
IPQS_API_KEY=""
# CAPTCHA_IPQS_TIMEOUT_MS="2500"
# CAPTCHA_IPQS_CACHE_TTL_MS="3600000"
# CAPTCHA_IPQS_STRICTNESS="0"
# CAPTCHA_IPQS_BLOCK_SCORE="90"
